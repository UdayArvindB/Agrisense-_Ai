# AgriSense AI Frontend Environment Variables
# Copy this file to .env.local for local overrides.
# In Vercel, add these variables in: Project Settings -> Environment Variables.

# URL of the deployed FastAPI backend (e.g. on Render, Railway, Fly.io, or AWS)
# If left empty, the frontend will automatically use its built-in resilient local fallback mode.
VITE_API_BASE_URL=
