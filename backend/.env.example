# AgriSense AI Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Configuration (Set either GEMINI_API_KEY or OPENAI_API_KEY)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini # or "openai" or "mock"
LLM_MODEL=gemini-1.5-flash

# Embeddings & Vector Database
EMBEDDING_PROVIDER=local # or "sentence-transformers" or "openai"
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_DIR=backend/knowledge/vector_store
DOCUMENTS_DIR=backend/knowledge/documents

# Machine Learning Classifier
ML_MODEL_TYPE=mock # or "torch" when .pth weights are provided
ML_MODEL_PATH=backend/app/models/crop_disease_model/efficientnet_agri.pth
CONFIDENCE_THRESHOLD=0.60
